# Camoufox Connector Configuration
# Copy this file to .env and customize as needed

# Operating mode: "single" or "pool"
MODE=single

# Number of browser instances (only used in pool mode)
POOL_SIZE=3

# HTTP API port for health checks and management
API_PORT=8080

# Starting port for browser WebSocket endpoints
WS_PORT_START=9222

# Browser configuration
HEADLESS=true
GEOIP=true
HUMANIZE=true
BLOCK_IMAGES=false

# Proxy configuration (optional)
# Single proxy (all instances use it):
# PROXY=http://user:pass@host:port
# Or a rotating pool - comma-separated, one assigned per instance (takes
# precedence over PROXY). A failing proxy can be blacklisted + rotated at runtime
# via POST /restart/{n}?blacklist=true.
# PROXIES=http://user:pass@host1:port,http://user:pass@host2:port

# Priority acquisition (optional, for the /acquire + /release API)
# Max simultaneous /acquire leases per browser instance (default 1):
# MAX_CONCURRENCY_PER_INSTANCE=1
# Allow higher-priority /acquire requests to preempt lower-priority leases:
# PREEMPTION=false
# Grace period (seconds) before a preempted lease is force-reclaimed:
# PREEMPT_GRACE=10
# Default seconds an /acquire waits for capacity before 503:
# ACQUIRE_TIMEOUT=30
# Max queued /acquire requests before returning 503 (bounds memory under load):
# MAX_WAITERS=1000

# Debug mode
DEBUG=false
